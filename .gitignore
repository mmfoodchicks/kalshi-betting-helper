# Python
__pycache__/
*.pyc
.venv/
venv/

# Local data
markets.db
predlog.db
*.db

# PC compute worker: the config holds SIM_TOKEN and must never be committed;
# the caches are per-machine scratch.
vigil-pc.cfg
pc-simcache/
pc-deepcache/
# the owner's DraftKings standings exports (dk_standings reads them on the PC;
# 170 MB each, and they name every entrant). Only the folder's README is
# tracked, so a git pull creates the folder with its instructions.
pc-standings/*
!pc-standings/README.txt
*.db-wal
*.db-shm
*.sqlite3

# Secrets / env
.env

# Deep-sim cache
data/
# the research evidence base (research/data) is committed on purpose: the
# guard suite and the fitting stages read it, and CI has no raw feeds
!research/data/

# Build artifacts (a 47MB playwright wheel was committed once)
*.whl
futures_history/

# backtest part files (merged into seeds/dfs_backtest_seed.json, which IS committed)
seeds/part_*.json

# research A/B handoff files: one per (board, mode), written by a child process
# and combined into sd_live_ab.json. Intermediates, and a stale one read as
# current is exactly the mistake that makes an A/B lie.
research/data/_ab_*.json
research/data/_res_*.json

# The week-2 harness's scratch: the plain standings CSV the frozen loader reads
# (the gzipped copy and its hash are the pinned artifacts) and the rehearsal
# selections made before the final receipt is written.
research/data/cl_week2/standings/
research/data/cl_week2/rehearsal/
research/data/cl_worlds_smoke.json
research/data/sd_worlds_smoke.json
research/data/cl_own_smoke.json

# Monday night 2026-10-19 showdown export (S7 prospective test): frozen locally for the scorer,
# never committed -- it names every entrant (only the summary and the scored artifact are committed)
research/data/dk_standings/contest-standings-196786690.csv.gz

# The rushing model's registered dataset (research/reports/nfl_rush_model.md): its RB and QB
# rows carry PFR- and NGS-derived columns, display-only by the licence default (Q10), so this
# public repo holds only their sha256 (prereg.json) and the owner holds the files. The props
# logs carry Kalshi's prices: their copies live on sim-history (props/nfl_props_<season>_wNN.json).
research/data/nfl_rush/rb_games_2023_2026.csv.gz
research/data/nfl_rush/qb_games_2023_2026.csv.gz
research/data/nfl_rush_model/inputs/nfl_props_*.json
# ... and the decisive run's own dataset, built after the window: the same restricted columns
research/data/nfl_rush_model/prospective_dataset/

# the shared calibration fit (calibrate.params_path): fitted on the server,
# fetched by the PC beside its predlog.db; never source
calib_params.json
mx_record.db*
