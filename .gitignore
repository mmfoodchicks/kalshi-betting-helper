# Python
__pycache__/
*.pyc
.venv/
venv/

# Local data
markets.db
predlog.db
*.db

# PC compute worker: the config holds SIM_TOKEN and must never be committed;
# the caches are per-machine scratch.
vigil-pc.cfg
pc-simcache/
pc-deepcache/
*.db-wal
*.db-shm
*.sqlite3

# Secrets / env
.env

# Deep-sim cache
data/
# the research evidence base (research/data) is committed on purpose: the
# guard suite and the fitting stages read it, and CI has no raw feeds
!research/data/

# Build artifacts (a 47MB playwright wheel was committed once)
*.whl
futures_history/

# backtest part files (merged into seeds/dfs_backtest_seed.json, which IS committed)
seeds/part_*.json

# research A/B handoff files: one per (board, mode), written by a child process
# and combined into sd_live_ab.json. Intermediates, and a stale one read as
# current is exactly the mistake that makes an A/B lie.
research/data/_ab_*.json
