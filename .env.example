# Copy to .env and fill in (used by docker-compose). Never commit the real .env.
DOMAIN=vigil.yourdomain.com
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
# Optional HTTP Basic login (leave APP_PASSWORD blank for an open site):
APP_USER=vigil
APP_PASSWORD=
# Keep tier gating off (owner/God mode for everyone) for now:
TIERS_ENFORCED=0
